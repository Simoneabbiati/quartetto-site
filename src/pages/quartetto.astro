---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');

const singers = (await getCollection('cantanti', ({ data }) => data.lingua === 'en')).sort(
  (a, b) => a.data.ordine - b.data.ordine
);

const aboutPages = await getCollection('pagine', ({ id, data }) => id.startsWith('chi-siamo') && data.lingua === 'en');
const about = aboutPages[0];
const Content = about ? (await about.render()).Content : null;
---

<Base title="The Ensemble" description="About us: story and voices of the ensemble.">

  <!-- Page header -->
  <section class="container-default testa-pagina">
    <p class="label-caps mb-5">{t('nav.quartetto')}</p>
    <h1 class="font-serif max-w-2xl">{about?.data.titolo ?? 'About us'}</h1>
    {about?.data.sottotitolo && (
      <p class="fs-lede text-ink-soft mt-4 misura">{about.data.sottotitolo}</p>
    )}
  </section>

  <!-- Narrative bio -->
  <section class="container-narrow corpo-pagina">
    {Content ? (
      <div class="prose">
        <Content />
      </div>
    ) : (
      <p class="text-ink-muted italic">Ensemble bio to be written in src/content/pagine/chi-siamo-en.md</p>
    )}
  </section>

  <div class="divider-ornament"><span class="font-serif">✦</span></div>

  <!-- Singers -->
  <section class="container-default corpo-pagina">
    <p class="label-caps mb-5 text-center">The singers</p>
    <h2 class="font-serif text-center" style="margin-bottom: var(--space-7)">The voices</h2>

    <div class="grid md:grid-cols-2 gap-16">
      {singers.length > 0 ? (
        singers.map(async (singer) => {
          const { Content: BioContent } = await singer.render();
          const voiceLabel = t(`cantanti.${singer.data.voce}`);
          return (
            <article>
              <div class="flex items-center gap-4 mb-3">
                {singer.data.foto && (
                  <img
                    src={singer.data.foto}
                    alt={singer.data.nome}
                    class="w-14 h-14 rounded-full object-cover flex-shrink-0 grayscale hover:grayscale-0 transition-all duration-700"
                  />
                )}
                <div>
                  <p class="label-caps mb-1">{voiceLabel}</p>
                  <h3>{singer.data.nome}</h3>
                </div>
              </div>
              <p class="text-ink-soft mb-5 leading-relaxed">{singer.data.bioBreve}</p>
              <details>
                <summary class="nav-link cursor-pointer">Full biography</summary>
                <div class="prose mt-5">
                  <BioContent />
                </div>
              </details>
            </article>
          );
        })
      ) : (
        <p class="col-span-2 text-center text-ink-muted italic">
          Singer profiles to be created in src/content/cantanti/
        </p>
      )}
    </div>
  </section>

</Base>
