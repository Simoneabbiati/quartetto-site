---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { useTranslations, withBase } from '../../i18n/utils';

const t = useTranslations('it');

Astro.response.headers.set('Cache-Control', 'no-store');

interface Spartito {
  titolo: string;
  compositore: string;
  organico: string | null;
}

const db = (Astro.locals as any).runtime?.env?.DB;
let spartiti: Spartito[] = [];

if (db) {
  try {
    const { results } = await db
      .prepare('SELECT titolo, compositore, organico FROM spartiti ORDER BY compositore, titolo')
      .all();
    spartiti = results as Spartito[];
  } catch {
    spartiti = [];
  }
}

---

<Base title="Repertorio" description="Il repertorio dell'ensemble — i brani attualmente in libreria.">

  <!-- Page header -->
  <section class="container-default testa-pagina">
    <p class="label-caps mb-4">{t('nav.repertorio')}</p>
    <h1 class="font-serif max-w-xl">Il repertorio</h1>
    <p class="fs-lede text-ink-soft mt-3 max-w-lg">
      I brani attualmente in libreria, aggiornati man mano che aggiungiamo nuovi spartiti.
    </p>
  </section>

  <!-- Brani: autore e titolo sulla stessa riga -->
  <div class="container-default corpo-pagina">
    {spartiti.length === 0 && (
      <p class="text-ink-soft">Repertorio in arrivo.</p>
    )}

    <div class="space-y-0">
      {spartiti.map((brano, i) => (
        <div
          class="grid grid-cols-[1fr_auto] gap-4 py-3.5 items-baseline"
          style={`border-bottom: 1px solid rgba(26,37,53,${i === spartiti.length - 1 ? '0' : '0.06'})`}
        >
          <p class="fs-title min-w-0">
            <span class="text-ink-soft">{brano.compositore}</span>
            <span class="text-ink-muted mx-2" aria-hidden="true">—</span>
            <span>{brano.titolo}</span>
          </p>
          {brano.organico && (
            <span class="label-caps justify-self-end">{brano.organico}</span>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Footer note -->
  <section class="border-t py-10" style="border-color: rgba(26,37,53,0.08); background-color: #f5f5f5;">
    <div class="container-narrow text-center">
      <p class="text-ink-muted misura mx-auto">
        Il repertorio è in continua evoluzione. Per programmi personalizzati su liturgia, concerto o festival,
        <a href={withBase('/it/contatti')} class="text-accent hover:underline">contattateci</a>.
      </p>
    </div>
  </section>

</Base>
