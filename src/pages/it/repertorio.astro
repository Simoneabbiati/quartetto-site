---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { useTranslations, withBase } from '../../i18n/utils';

const t = useTranslations('it');

Astro.response.headers.set('Cache-Control', 'no-store');

interface Spartito {
  titolo: string;
  compositore: string;
  organico: string | null;
}

const db = (Astro.locals as any).runtime?.env?.DB;
let spartiti: Spartito[] = [];

if (db) {
  try {
    const { results } = await db
      .prepare('SELECT titolo, compositore, organico FROM spartiti ORDER BY compositore, titolo')
      .all();
    spartiti = results as Spartito[];
  } catch {
    spartiti = [];
  }
}

// Raggruppa per compositore, nell'ordine già dato dalla query
const byCompositore: { compositore: string; brani: Spartito[] }[] = [];
for (const s of spartiti) {
  const gruppo = byCompositore.find((g) => g.compositore === s.compositore);
  if (gruppo) gruppo.brani.push(s);
  else byCompositore.push({ compositore: s.compositore, brani: [s] });
}
---

<Base title="Repertorio" description="Il repertorio dell'ensemble — i brani attualmente in libreria.">

  <!-- Page header -->
  <section class="container-default pt-16 pb-12" style="border-bottom: 1px solid rgba(26,37,53,0.07)">
    <p class="label-caps mb-4">{t('nav.repertorio')}</p>
    <h1 class="font-serif max-w-xl">Il repertorio</h1>
    <p class="text-base text-ink-soft mt-3 font-serif italic max-w-lg">
      I brani attualmente in libreria, aggiornati man mano che aggiungiamo nuovi spartiti.
    </p>
  </section>

  <!-- Compositori -->
  <div class="container-default py-12 pb-24 space-y-16">
    {byCompositore.length === 0 && (
      <p class="text-ink-soft">Repertorio in arrivo.</p>
    )}

    {byCompositore.map((gruppo) => (
      <section>
        <div class="flex items-baseline gap-6 mb-6 pb-4" style="border-bottom: 1px solid rgba(61,107,138,0.25)">
          <h2 class="font-serif text-2xl">{gruppo.compositore}</h2>
        </div>

        <div class="space-y-0">
          {gruppo.brani.map((brano, i) => (
            <div
              class="grid md:grid-cols-[1fr_auto] gap-2 py-3.5 items-baseline"
              style={`border-bottom: 1px solid rgba(26,37,53,${i === gruppo.brani.length - 1 ? '0' : '0.06'})`}
            >
              <span class="font-serif text-[1.05rem]">{brano.titolo}</span>
              {brano.organico && (
                <span class="label-caps text-[0.65rem] md:justify-self-end" style="color: rgba(112,136,165,0.9)">{brano.organico}</span>
              )}
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- Footer note -->
  <section class="border-t py-10" style="border-color: rgba(26,37,53,0.08); background-color: #e5ecf4;">
    <div class="container-narrow text-center">
      <p class="text-sm text-ink-muted font-serif italic">
        Il repertorio è in continua evoluzione. Per programmi personalizzati su liturgia, concerto o festival,
        <a href={withBase('/it/contatti')} class="text-accent hover:underline">contattateci</a>.
      </p>
    </div>
  </section>

</Base>
