---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('it');

const cantanti = (await getCollection('cantanti', ({ data }) => data.lingua === 'it')).sort(
  (a, b) => a.data.ordine - b.data.ordine
);

const pagineChiSiamo = await getCollection('pagine', ({ id, data }) => id === 'chi-siamo.md' && data.lingua === 'it');
const chiSiamo = pagineChiSiamo[0];
const Content = chiSiamo ? (await chiSiamo.render()).Content : null;
---

<Base title="L'Ensemble" description="Chi siamo: storia e voci dell'ensemble.">

  <!-- Page header -->
  <section class="container-default testa-pagina">
    <p class="label-caps mb-5">{t('nav.quartetto')}</p>
    <h1 class="font-serif max-w-2xl">{chiSiamo?.data.titolo ?? 'Chi siamo'}</h1>
    {chiSiamo?.data.sottotitolo && (
      <p class="fs-lede text-ink-soft mt-4 misura">{chiSiamo.data.sottotitolo}</p>
    )}
  </section>

  <!-- Bio narrativa -->
  <section class="container-narrow corpo-pagina">
    {Content ? (
      <div class="prose">
        <Content />
      </div>
    ) : (
      <p class="text-ink-muted italic">Bio del quartetto da scrivere in src/content/pagine/chi-siamo.md</p>
    )}
  </section>

  <div class="divider-ornament"><span class="font-serif">✦</span></div>

  <!-- Cantanti -->
  <section class="container-default corpo-pagina">
    <p class="label-caps mb-5 text-center">I cantanti</p>
    <h2 class="font-serif text-center" style="margin-bottom: var(--space-7)">Le voci</h2>

    <!-- Per ora solo nome e voce: le biografie (src/content/cantanti) si
         mostreranno quando saranno scritte. -->
    <ul class="voci-elenco">
      {cantanti.map((cantante) => (
        <li>
          <p class="label-caps">{t(`cantanti.${cantante.data.voce}`)}</p>
          <h3>{cantante.data.nome}</h3>
        </li>
      ))}
    </ul>
    </div>
  </section>

</Base>

<style>
  .voci-elenco {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 52rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .voci-elenco li { display: flex; flex-direction: column; gap: var(--space-2); }
</style>
