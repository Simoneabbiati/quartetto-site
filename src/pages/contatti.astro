---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('it');

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/YOUR_FORM_ID';
---

<Base title="Contatti" description="Contatta VoxMea per scritturare un concerto o una liturgia.">

  <!-- Page header -->
  <section class="container-default pt-16 pb-12" style="border-bottom: 1px solid rgba(28,20,16,0.07)">
    <p class="label-caps mb-5">{t('nav.contatti')}</p>
    <h1 class="font-serif">{t('contatti.titolo')}</h1>
    <p class="text-lg text-ink-soft mt-4 font-serif italic max-w-xl">{t('contatti.intro')}</p>
  </section>

  <section class="container-narrow py-16 pb-28">
    <form action={FORMSPREE_ENDPOINT} method="POST" class="space-y-8">

      <div class="grid md:grid-cols-2 gap-8">
        <label class="block">
          <span class="field-label">{t('contatti.form.nome')} *</span>
          <input type="text" name="nome" required class="field-input" />
        </label>
        <label class="block">
          <span class="field-label">{t('contatti.form.ruolo')}</span>
          <input type="text" name="ruolo" class="field-input" />
        </label>
      </div>

      <label class="block">
        <span class="field-label">{t('contatti.form.ente')}</span>
        <input type="text" name="ente" class="field-input" />
      </label>

      <label class="block">
        <span class="field-label">{t('contatti.form.tipo')} *</span>
        <select name="tipo" required class="field-input">
          <option value="liturgia">{t('contatti.form.tipoLiturgia')}</option>
          <option value="concerto">{t('contatti.form.tipoConcerto')}</option>
          <option value="festival">{t('contatti.form.tipoFestival')}</option>
          <option value="altro">{t('contatti.form.tipoAltro')}</option>
        </select>
      </label>

      <div class="grid md:grid-cols-2 gap-8">
        <label class="block">
          <span class="field-label">{t('contatti.form.data')}</span>
          <input type="date" name="data" class="field-input" />
        </label>
        <label class="block">
          <span class="field-label">{t('contatti.form.luogo')}</span>
          <input type="text" name="luogo" class="field-input" />
        </label>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <label class="block">
          <span class="field-label">{t('contatti.form.email')} *</span>
          <input type="email" name="email" required class="field-input" />
        </label>
        <label class="block">
          <span class="field-label">{t('contatti.form.telefono')}</span>
          <input type="tel" name="telefono" class="field-input" />
        </label>
      </div>

      <label class="block">
        <span class="field-label">{t('contatti.form.note')}</span>
        <textarea name="note" rows="5" class="field-input resize-none" style="border: 1px solid rgba(26,26,26,0.15); padding: 0.75rem;"></textarea>
      </label>

      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="pt-2">
        <button type="submit" class="btn-primary">{t('contatti.form.invia')}</button>
      </div>

    </form>
  </section>

</Base>
