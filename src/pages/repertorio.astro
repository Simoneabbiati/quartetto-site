---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { useTranslations, withBase } from '../i18n/utils';

const t = useTranslations('en');

Astro.response.headers.set('Cache-Control', 'no-store');

interface Spartito {
  titolo: string;
  compositore: string;
  organico: string | null;
}

const db = (Astro.locals as any).runtime?.env?.DB;
let spartiti: Spartito[] = [];

if (db) {
  try {
    const { results } = await db
      .prepare('SELECT titolo, compositore, organico FROM spartiti ORDER BY compositore, titolo')
      .all();
    spartiti = results as Spartito[];
  } catch {
    spartiti = [];
  }
}

---

<Base title="Repertoire" description="The ensemble's repertoire — the pieces currently in our library.">

  <!-- Page header -->
  <section class="container-default testa-pagina">
    <p class="label-caps mb-4">{t('nav.repertorio')}</p>
    <h1 class="font-serif max-w-xl">The repertoire</h1>
    <p class="fs-lede text-ink-soft mt-3 max-w-lg">
      The pieces currently in our library, updated as we add new scores.
    </p>
  </section>

  <!-- Pieces: autore e titolo sulla stessa riga -->
  <div class="container-default corpo-pagina">
    {spartiti.length === 0 && (
      <p class="text-ink-soft">Repertoire coming soon.</p>
    )}

    <div class="space-y-0">
      {spartiti.map((brano, i) => (
        <div
          class="grid grid-cols-[1fr_auto] gap-4 py-3.5 items-baseline"
          style={`border-bottom: 1px solid rgba(19,28,41,${i === spartiti.length - 1 ? '0' : '0.06'})`}
        >
          <p class="fs-title min-w-0">
            <span class="text-ink-soft">{brano.compositore === 'Anonimo' ? 'Anonymous' : brano.compositore}</span>
            <span class="text-ink-muted mx-2" aria-hidden="true">—</span>
            <span>{brano.titolo}</span>
          </p>
          {brano.organico && (
            <span class="label-caps justify-self-end">{brano.organico}</span>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Footer note -->
  <section class="border-t py-10" style="border-color: rgba(19,28,41,0.08); background-color: #f5f5f5;">
    <div class="container-narrow text-center">
      <p class="text-ink-muted misura mx-auto">
        The repertoire is continually evolving. For programmes tailored to a liturgy, concert or festival,
        <a href={withBase('/contatti')} class="text-accent hover:underline">get in touch</a>.
      </p>
    </div>
  </section>

</Base>
