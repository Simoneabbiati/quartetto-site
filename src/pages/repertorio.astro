---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('it');

const periodi = [
  {
    titolo: 'Gregoriano e Medioevo',
    slug: 'gregoriano',
    descrizione: 'Il canto della Chiesa alle sue origini — un repertorio che sopravvive intatto da oltre mille anni.',
    brani: [
      { titolo: 'Ave Maris Stella', autore: 'Anonimo — Inno Gregoriano', periodo: 'Tardo Antico / Medioevo', tags: ['Mariano', 'Liturgico'] },
    ],
  },
  {
    titolo: 'Rinascimento',
    slug: 'rinascimento',
    descrizione: 'Il grande fiorire della polifonia sacra europea: il contrappunto come preghiera, la voce come architettura.',
    brani: [
      { titolo: 'Sicut Cervus', autore: 'Giovanni Pierluigi da Palestrina', periodo: 'c. 1575', tags: ['Liturgico'] },
      { titolo: 'Caligaverunt Oculi Mei', autore: 'Tomás Luis de Victoria', periodo: 'XVI sec.', tags: ['Settimana Santa', 'Tenebrae'] },
      { titolo: 'Vere Languores', autore: 'Tomás Luis de Victoria', periodo: 'XVI sec.', tags: ['Quaresima', 'Settimana Santa'] },
      { titolo: 'If ye love me', autore: 'Thomas Tallis', periodo: 'c. 1549', tags: ['Pentecoste', 'Liturgico'] },
      { titolo: 'Drop Drop Slow Tears', autore: 'Orlando Gibbons', periodo: 'c. 1610', tags: ['Quaresima', 'Liturgico'] },
      { titolo: 'A Piè dell\'Alta e Triomphale Palma', autore: 'Anonimo — Lauda', periodo: '1591', tags: ['Maria Maddalena', 'Pasqua'] },
      { titolo: 'O Cor Soave', autore: 'Anonimo (attr. P. Francesco Soto de Langa)', periodo: 'Tardo XVI sec.', tags: ['Mariano', 'Liturgico'] },
    ],
  },
  {
    titolo: 'Barocco',
    slug: 'barocco',
    descrizione: "La voce sacra nel nuovo linguaggio dell'espressione affettiva.",
    brani: [
      { titolo: 'O Jesulein süss (O little one sweet)', autore: 'Johann Sebastian Bach', periodo: 'XVIII sec.', tags: ['Natale'] },
    ],
  },
  {
    titolo: 'Novecento',
    slug: 'novecento',
    descrizione: 'Compositori del Novecento che hanno mantenuto viva la vena sacra in epoche di trasformazione.',
    brani: [
      { titolo: 'Hymne à la Vierge', autore: 'Pierre Villet', periodo: '1954', tags: ['Mariano'] },
      { titolo: 'Jesu Parvule', autore: 'Alfred Burt', periodo: 'Metà XX sec.', tags: ['Natale'] },
      { titolo: 'Nigh Bethlehem', autore: 'Alfred Burt', periodo: 'Metà XX sec.', tags: ['Natale'] },
      { titolo: 'O Sacrum Convivium', autore: 'Luigi Molfino', periodo: '1916–2012', tags: ['Corpus Domini', 'Eucaristia'] },
      { titolo: 'The Irish Blessing', autore: 'James E. Moore Jr.', periodo: 'XX sec.', tags: ['Congedo', 'Benedizione'] },
    ],
  },
  {
    titolo: 'Contemporaneo',
    slug: 'contemporaneo',
    descrizione: 'La tradizione sacra continua nel linguaggio del nostro tempo — contemplazione, bellezza, spiritualità.',
    brani: [
      { titolo: 'Northern Lights', autore: 'Ola Gjeilo', periodo: 'Contemporaneo', tags: ['Spiritualità', 'Contemplazione'] },
      { titolo: 'Ubi Caritas', autore: 'Ola Gjeilo', periodo: 'Contemporaneo', tags: ['Giovedì Santo', 'Matrimoni'] },
      { titolo: 'Magnum Mysterium', autore: 'Buonavitacola', periodo: 'Contemporaneo', tags: ['Natale', 'Epifania'] },
      { titolo: 'Nunc Dimittis', autore: 'Paul Smith', periodo: 'Contemporaneo', tags: ['Compieta', 'Liturgico'] },
      { titolo: 'Memorare', autore: 'Walter Muto', periodo: 'Contemporaneo', tags: ['Mariano', 'Spiritualità'] },
      { titolo: 'There is more love', autore: 'Bay Ridge Band', periodo: 'Contemporaneo', tags: ['Spiritualità'] },
    ],
  },
  {
    titolo: 'Tradizione Popolare',
    slug: 'tradizione',
    descrizione: "Canti trasmessi di generazione in generazione — l'anima popolare della devozione.",
    brani: [
      { titolo: 'Carol of the Bells', autore: 'M. Leontovych', periodo: 'Inizio XX sec.', tags: ['Natale'] },
      { titolo: 'Saint Joseph i la Mare de Déu', autore: 'Canto popolare catalano', periodo: 'Tradizionale', tags: ['Natale', 'Mariano'] },
      { titolo: 'Rocking', autore: 'Tradizionale Ceco (arr. David Willcocks)', periodo: 'Tradizionale', tags: ['Natale'] },
    ],
  },
];

const tagColors: Record<string, string> = {
  'Natale':          'rgba(168,126,24,0.13)',
  'Mariano':         'rgba(61,107,138,0.10)',
  'Quaresima':       'rgba(26,37,53,0.07)',
  'Settimana Santa': 'rgba(26,37,53,0.07)',
  'Tenebrae':        'rgba(26,37,53,0.07)',
  'Liturgico':       'rgba(26,37,53,0.06)',
  'Spiritualità':    'rgba(61,107,138,0.10)',
  'Contemplazione':  'rgba(61,107,138,0.10)',
};
---

<Base title="Repertorio" description="Il repertorio di VoxMea — dalla polifonia rinascimentale alla musica sacra contemporanea.">

  <!-- Page header -->
  <section class="container-default pt-16 pb-12" style="border-bottom: 1px solid rgba(26,37,53,0.07)">
    <p class="label-caps mb-4">{t('nav.repertorio')}</p>
    <h1 class="font-serif max-w-xl">Il repertorio</h1>
    <p class="text-base text-ink-soft mt-3 font-serif italic max-w-lg">
      Dal canto gregoriano alla musica del nostro tempo — organizzato per periodo storico.
    </p>
  </section>

  <!-- Periodi -->
  <div class="container-default py-12 pb-24 space-y-16">
    {periodi.map((periodo) => (
      <section id={periodo.slug}>

        <!-- Periodo header -->
        <div class="flex items-baseline gap-6 mb-6 pb-4" style="border-bottom: 1px solid rgba(168,126,24,0.25)">
          <h2 class="font-serif text-2xl">{periodo.titolo}</h2>
          <p class="text-sm text-ink-soft font-serif italic hidden md:block">{periodo.descrizione}</p>
        </div>

        <!-- Descrizione mobile -->
        <p class="text-sm text-ink-soft font-serif italic mb-5 md:hidden">{periodo.descrizione}</p>

        <!-- Lista brani -->
        <div class="space-y-0">
          {periodo.brani.map((brano, i) => (
            <div
              class="grid md:grid-cols-[1fr_auto] gap-2 py-3.5 items-baseline"
              style={`border-bottom: 1px solid rgba(26,37,53,${i === periodo.brani.length - 1 ? '0' : '0.06'})`}
            >
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="font-serif text-[1.05rem]">{brano.titolo}</span>
                <span class="text-sm text-ink-muted">{brano.autore}</span>
              </div>
              <div class="flex items-center gap-2 flex-wrap md:justify-end">
                <span class="label-caps text-[0.65rem]" style="color: rgba(112,136,165,0.9)">{brano.periodo}</span>
                {brano.tags.slice(0, 2).map(tag => (
                  <span
                    class="text-[0.65rem] font-serif italic px-2 py-0.5 rounded-sm"
                    style={`background: ${tagColors[tag] ?? 'rgba(26,37,53,0.06)'}; color: #354a65`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>

      </section>
    ))}
  </div>

  <!-- Footer note -->
  <section class="border-t py-10" style="border-color: rgba(26,37,53,0.08); background-color: #e5ecf4;">
    <div class="container-narrow text-center">
      <p class="text-sm text-ink-muted font-serif italic">
        Il repertorio è in continua evoluzione. Per programmi personalizzati su liturgia, concerto o festival,
        <a href="/contatti" class="text-accent hover:underline">contattateci</a>.
      </p>
    </div>
  </section>

</Base>
