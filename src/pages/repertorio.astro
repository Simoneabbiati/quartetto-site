---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('it');

const pagine = await getCollection('pagine', ({ id, data }) => id === 'repertorio.md' && data.lingua === 'it');
const repertorio = pagine[0];
const Content = repertorio ? (await repertorio.render()).Content : null;
---

<Base title="Repertorio" description="Il repertorio di VoxMea — dalla polifonia rinascimentale alla musica sacra contemporanea.">

  <!-- Page header -->
  <section class="container-default pt-20 pb-16" style="border-bottom: 1px solid rgba(26,26,26,0.07)">
    <p class="label-caps mb-5">{t('nav.repertorio')}</p>
    <h1 class="font-serif">{repertorio?.data.titolo ?? 'Repertorio'}</h1>
    <p class="text-lg text-ink-soft mt-4 font-serif italic max-w-xl">
      Dal canto gregoriano alla musica del nostro tempo — un repertorio costruito attorno alla tradizione sacra vivente.
    </p>
  </section>

  <section class="container-narrow py-16 pb-28">
    {Content ? (
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    ) : (
      <p class="text-ink-muted italic py-8">Pagina repertorio da scrivere in src/content/pagine/repertorio.md</p>
    )}
  </section>

</Base>
