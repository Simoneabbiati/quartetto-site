---
import Base from '../layouts/Base.astro';
import ConcertoCard from '../components/ConcertoCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('it');

const oggi = new Date();
oggi.setHours(0, 0, 0, 0);

const tutti = await getCollection('concerti', ({ data }) => data.lingua === 'it');

const prossimi = tutti
  .filter((c) => c.data.data >= oggi)
  .sort((a, b) => a.data.data.getTime() - b.data.data.getTime());

const passati = tutti
  .filter((c) => c.data.data < oggi)
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime());
---

<Base title="Concerti" description="I prossimi concerti di VoxMea e l'archivio degli eventi passati.">

  <!-- Page header -->
  <section class="container-default pt-16 pb-12" style="border-bottom: 1px solid rgba(26,37,53,0.07)">
    <p class="label-caps mb-5">{t('nav.concerti')}</p>
    <h1 class="font-serif">{t('concerti.prossimi')}</h1>
  </section>

  <section class="container-default py-16">
    {prossimi.length === 0 ? (
      <p class="text-ink-muted italic py-8">{t('concerti.nessunConcerto')}</p>
    ) : (
      <div>
        {prossimi.map((c) => <ConcertoCard concerto={c} />)}
      </div>
    )}

    {passati.length > 0 && (
      <>
        <div class="divider-ornament mt-28"><span class="font-serif">✦</span></div>
        <p class="label-caps mb-5 mt-6">{t('concerti.archivio')}</p>
        <h2 class="font-serif mb-14">{t('concerti.archivio')}</h2>
        <div>
          {passati.map((c) => <ConcertoCard concerto={c} variant="compact" />)}
        </div>
      </>
    )}
  </section>

</Base>
