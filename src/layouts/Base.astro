---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, withBase, stripBase } from '../i18n/utils';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage = withBase('/images/og-default.jpg') } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fullTitle = title === 'home' ? `${t('site.name')} — ${t('site.tagline')}` : `${title} · ${t('site.name')}`;
const metaDescription = description ?? t('site.tagline');

// URL bilingui per hreflang (base-aware): percorso logico senza base né /it
const cleanPath = stripBase(Astro.url.pathname).replace(/^\/it/, '') || '/';
const enUrl = new URL(withBase(cleanPath), Astro.site);
const itUrl = new URL(withBase(cleanPath === '/' ? '/it/' : `/it${cleanPath}`), Astro.site);
const defaultUrl = new URL(withBase('/'), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <!-- iOS non legge il favicon per "Aggiungi alla schermata Home": vuole
         esplicitamente questo, in PNG (l'SVG non è supportato qui). -->
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-title" content={t('site.name')} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />

    <!-- Hreflang per SEO bilingue -->
    <link rel="alternate" hreflang="it" href={itUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
