---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Avviso from '../components/Avviso.astro';
import { getLangFromUrl, useTranslations, withBase, stripBase } from '../i18n/utils';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage: ogImageProp } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Anteprima dei link (WhatsApp, social): nome e globo, nella lingua della pagina.
const ogImage = ogImageProp ?? withBase(lang === 'it' ? '/images/og-it.png' : '/images/og-en.png');

const fullTitle = title === 'home' ? `${t('site.name')} — ${t('site.tagline')}` : `${title} · ${t('site.name')}`;
const metaDescription = description ?? t('site.tagline');

// URL bilingui per hreflang (base-aware): percorso logico senza base né /it
const cleanPath = stripBase(Astro.url.pathname).replace(/^\/it/, '') || '/';
const enUrl = new URL(withBase(cleanPath), Astro.site);
const itUrl = new URL(withBase(cleanPath === '/' ? '/it/' : `/it${cleanPath}`), Astro.site);
const defaultUrl = new URL(withBase('/'), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <!-- iOS non legge il favicon per "Aggiungi alla schermata Home": vuole
         esplicitamente questo, in PNG (l'SVG non è supportato qui). -->
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-title" content={t('site.name')} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'it' ? 'Concordia Singers, ensemble vocale a Milano: un globo con le linee che collegano Milano a Irlanda, Stati Uniti, Estonia e Turchia' : 'Concordia Singers, vocal ensemble in Milan: a globe with lines linking Milan to Ireland, the United States, Estonia and Turkey'} />
    <meta property="og:site_name" content="Concordia Singers" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />

    <!-- Hreflang per SEO bilingue -->
    <link rel="alternate" hreflang="it" href={itUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <!-- Instrument Sans (asse larghezza 75–100 e peso 400–600) + Instrument Serif per i testi latini -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wdth,wght@0,75..100,400..600;1,75..100,400..600&family=Instrument+Serif:ital@0;1&family=Italiana&display=swap" />


    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <!-- Il vecchio indirizzo (e il www) portano all'indirizzo ufficiale, stessa pagina -->
    <script is:inline>
      if (location.hostname === 'quartetto-site.pages.dev' || location.hostname === 'www.concordiasingers.it') {
        location.replace('https://concordiasingers.it' + location.pathname + location.search + location.hash);
      }
    </script>

    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <Avviso />
  </body>
</html>
