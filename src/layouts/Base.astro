---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage = '/images/og-default.jpg' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fullTitle = title === 'home' ? `VoxMea — ${t('site.tagline')}` : `${title} · VoxMea`;
const metaDescription = description ?? t('site.tagline');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />

    <!-- Hreflang per SEO bilingue -->
    <link rel="alternate" hreflang="it" href={new URL(Astro.url.pathname.replace(/^\/en/, ''), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${Astro.url.pathname.replace(/^\/en/, '')}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={Astro.site} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
