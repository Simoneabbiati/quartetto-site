---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

export interface Props {
  concerto: CollectionEntry<'concerti'>;
  variant?: 'full' | 'compact';
}

const { concerto, variant = 'full' } = Astro.props;
const { data } = concerto;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const dateFormatter = new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const formattedDate = dateFormatter.format(data.data);
---

<article class:list={["border-b border-ink/10 last:border-b-0", variant === "compact" ? "pt-1 pb-6" : "py-8"]}>
  <div class="grid md:grid-cols-[180px_1fr] gap-6">
    <div>
      <div class="font-medium">{formattedDate}</div>
      {data.ora && <div class="fs-small text-ink-muted mt-1">{data.ora}</div>}
    </div>

    <div>
      <h3 class="mb-2">{data.titolo}</h3>
      <p class="text-ink-soft mb-3 misura">
        {data.luogo} · <span class="text-ink-muted">{data.citta}</span>
      </p>

      {
        variant === 'full' && data.programma && data.programma.length > 0 && (
          <details class="mb-3">
            <summary class="label-caps cursor-pointer hover:text-accent transition-colors">
              {t('concerti.programma')}
            </summary>
            <ul class="mt-3 space-y-1 text-ink-soft misura">
              {data.programma.map((brano) => (
                <li>
                  <span class="font-medium">{brano.compositore}</span>
                  <span class="text-ink-muted"> — {brano.opera}</span>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      <div class="flex flex-wrap gap-4 fs-small">
        {data.ingresso && <span class="text-ink-muted">{t('concerti.ingresso')}: {data.ingresso}</span>}
        {
          data.biglietti && (
            <a href={data.biglietti} target="_blank" rel="noopener" class="text-accent hover:text-accent-dark underline">
              {t('concerti.biglietti')} →
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>
