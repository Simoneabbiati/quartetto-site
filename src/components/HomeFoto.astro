---
// Una foto della homepage: WebP in due misure (public/images/home/<nome>-800|1600.webp),
// il browser sceglie quella giusta per lo schermo. `classe` decide posizione e
// larghezza nella griglia sparsa della homepage.
import { withBase } from '../i18n/utils';

interface Props {
  nome: string;
  alt: string;
  verticale?: boolean;
  classe?: string;
  sizes?: string;
  /** true per la prima foto visibile: niente lazy-load, priorità alta (LCP su telefono). */
  prioritaria?: boolean;
  /** Disposizione nel collage, in % della colonna: [larghezza, da sinistra, spostamento verticale].
      Valori negativi in verticale = la foto risale e si sovrappone alla precedente. */
  pos?: [number, number, number];
  posMobile?: [number, number, number];
}

const { nome, alt, verticale = false, classe = '', sizes = '(min-width: 768px) 40vw, 80vw', pos, posMobile, prioritaria = false } = Astro.props;
const m = posMobile ?? pos;
const stile = pos
  ? `--w:${pos[0]}%;--x:${pos[1]}%;--y:${pos[2]}%;--wm:${m![0]}%;--xm:${m![1]}%;--ym:${m![2]}%`
  : undefined;
const src = (w: number) => withBase(`/images/home/${nome}-${w}.webp`);
---

<figure class:list={['foto-home', pos && 'collage-foto', classe]} style={stile}>
  <img
    src={src(800)}
    srcset={`${src(800)} 800w, ${src(1600)} 1600w`}
    sizes={sizes}
    alt={alt}
    width={verticale ? 1200 : 1600}
    height={verticale ? 1600 : 1200}
    loading={prioritaria ? 'eager' : 'lazy'}
    fetchpriority={prioritaria ? 'high' : 'auto'}
    decoding="async"
    class="block w-full h-auto"
  />
</figure>
