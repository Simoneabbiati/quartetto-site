---
// Divisore tra le sezioni, alla maniera degli studi di architettura: un filo
// sottile a tutta larghezza con un breve tratto bronzo all'inizio, che si
// disegna quando entra nello schermo. Solo decorativo.
---
<div class="divisore" aria-hidden="true"><span></span></div>

<style>
  .divisore {
    position: relative;
    margin-inline: var(--gutter);
    height: 1px;
    background: var(--filo, #E2D9CA);
  }
  .divisore span {
    position: absolute;
    left: 0;
    top: -1px;
    height: 3px;
    width: clamp(48px, 6vw, 88px);
    background: var(--bronzo);
    transform-origin: left;
    transition: transform 1.1s cubic-bezier(.2, .7, .2, 1) .15s;
  }
  :global(.js-attivo) .divisore:not(.visto) span { transform: scaleX(0); }
  @media (prefers-reduced-motion: reduce) {
    .divisore span { transition: none; transform: none !important; }
  }
</style>

<script>
  const fili = document.querySelectorAll('.divisore');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((voci) => voci.forEach((v) => {
      if (v.isIntersecting) { v.target.classList.add('visto'); io.unobserve(v.target); }
    }), { threshold: 1, rootMargin: '0px 0px -12% 0px' });
    fili.forEach((f) => io.observe(f));
  } else fili.forEach((f) => f.classList.add('visto'));
</script>
