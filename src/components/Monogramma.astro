---
// Monogramma Concordia: due C in Cormorant Garamond, una grande e una più
// piccola rovesciata che si incastra fra le sue terminazioni ("con" e "cor").
// Colore: bronzo su fondo chiaro (default), oro su fondo scuro.
interface Props { size?: string; colore?: string; classe?: string }
const { size = '1.6em', colore = 'var(--bronzo)', classe = '' } = Astro.props;
---
<svg class:list={['monogramma', classe]} viewBox="20 20 165 165" width={size} height={size} aria-hidden="true" focusable="false">
  <g font-family="'Cormorant Garamond', Garamond, Georgia, serif" font-weight="500" fill={colore}>
    <text x="84" y="154" font-size="190" text-anchor="middle">C</text>
    <text transform="translate(142 130) scale(-1 1)" font-size="104" text-anchor="middle">C</text>
  </g>
</svg>
