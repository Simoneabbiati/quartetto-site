---
import { getLangFromUrl, useTranslations, withBase } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';
import Logo from './Logo.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const prefix = lang === 'en' ? '' : '/it';

const navItems = [
  { href: withBase(prefix ? `${prefix}/` : '/'), label: t('nav.home') },
  { href: withBase(`${prefix}/quartetto`), label: t('nav.quartetto') },
  { href: withBase(`${prefix}/repertorio`), label: t('nav.repertorio') },
  { href: withBase(`${prefix}/concerti`), label: t('nav.concerti') },
  { href: withBase(`${prefix}/media`), label: t('nav.media') },
  { href: withBase(`${prefix}/contatti`), label: t('nav.contatti') },
  { href: withBase(lang === 'it' ? '/riservato/?lang=it' : '/riservato/'), label: t('nav.riservato') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<header class="bg-paper/90 backdrop-blur-sm sticky top-0 z-50">
  <div class="px-4 md:px-6 flex items-center justify-between py-4">

    <a href={withBase(prefix || '/')} class="fs-title tracking-tight !leading-none hover:text-ink-muted transition-colors duration-200 inline-flex items-center gap-2 py-3 -my-3">
      <Logo />
    </a>

    <nav class="hidden md:flex items-center gap-7">
      {navItems.map((item) => {
        const isActive = currentPath === item.href.replace(/\/$/, '');
        return (
          <a href={item.href} class:list={['nav-link', isActive && 'active']}>
            {item.label}
          </a>
        );
      })}
      <LangSwitcher />
    </nav>

    <!-- Mobile controls -->
    <div class="flex items-center gap-1 md:hidden">
      <LangSwitcher />
      <button
        type="button"
        id="menu-toggle"
        class="mobile-menu-btn"
        aria-label="Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="hamburger" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <nav id="mobile-menu" class="mobile-menu md:hidden" aria-label="Primary">
    <div class="container-default flex flex-col pb-4">
      {navItems.map((item) => {
        const isActive = currentPath === item.href.replace(/\/$/, '');
        return (
          <a href={item.href} class:list={['mobile-nav-link', isActive && 'active']}>
            {item.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('is-open', open);
      menu.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-aperto', open);
    };

    btn.addEventListener('click', () => {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    // Close after tapping a link
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
