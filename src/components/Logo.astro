---
// Logo Concordia: monogramma + CONCORDIA in maiuscole spaziate (Cormorant
// Garamond), con "singers" piccolo sotto. `descrizione` aggiunge
// "vocal ensemble".
import Monogramma from './Monogramma.astro';
interface Props { descrizione?: boolean; misura?: string }
const { descrizione = false, misura = '2.1em' } = Astro.props;
---
<span class="logo" aria-label="Concordia Singers">
  <Monogramma size={misura} />
  <span class="logo-testo" aria-hidden="true">
    <span class="logo-nome">Concordia</span>
    <span class="logo-sotto">singers{descrizione && ' · vocal ensemble'}</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6em; }
  .logo-testo { display: flex; flex-direction: column; }
  .logo-nome {
    font-family: theme('fontFamily.marchio');
    font-weight: 500;
    text-transform: uppercase;
    font-size: 1em;
    letter-spacing: 0.32em;
    line-height: 1;
    margin-right: -0.32em;
    white-space: nowrap;
  }
  .logo-sotto {
    font-family: theme('fontFamily.sans');
    font-size: 0.42em;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: theme('colors.bronzo.scuro');
    margin-top: 0.55em;
    line-height: 1;
  }
  @media (max-width: 374px) { .logo-nome { letter-spacing: 0.24em; } }
</style>
