---
import { getLangFromUrl, stripBase, withBase } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const path = stripBase(Astro.url.pathname);

// Calcola gli URL "gemelli" per ciascuna lingua (con base path)
const stripped = path.replace(/^\/en/, '') || '/';
const itHref = withBase(stripped);
const enHref = withBase(stripped === '/' ? '/en/' : `/en${stripped}`);
---

<div class="flex items-center gap-2 text-xs uppercase tracking-wider">
  <a
    href={itHref}
    class:list={['hover:text-accent transition-colors', lang === 'it' ? 'text-accent font-semibold' : 'text-ink-muted']}
    aria-label="Italiano"
  >
    IT
  </a>
  <span class="text-ink-muted/50">/</span>
  <a
    href={enHref}
    class:list={['hover:text-accent transition-colors', lang === 'en' ? 'text-accent font-semibold' : 'text-ink-muted']}
    aria-label="English"
  >
    EN
  </a>
</div>
