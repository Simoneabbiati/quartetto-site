---
import { getLangFromUrl, stripBase, withBase } from '../i18n/utils';

const path = stripBase(Astro.url.pathname);

// L'area riservata sta su un unico percorso (Cloudflare Access protegge /riservato:
// una variante /it/riservato resterebbe scoperta), quindi lì la lingua passa da un
// parametro invece che dal percorso.
const inAreaRiservata = path.startsWith('/riservato');

let lang: 'it' | 'en';
let itHref: string;
let enHref: string;

if (inAreaRiservata) {
  lang = Astro.url.searchParams.get('lang') === 'it' ? 'it' : 'en';

  const params = new URLSearchParams(Astro.url.search);
  params.delete('lang');
  const altri = params.toString();

  enHref = withBase(path) + (altri ? `?${altri}` : '');
  itHref = withBase(path) + `?${altri ? altri + '&' : ''}lang=it`;
} else {
  lang = getLangFromUrl(Astro.url);
  const stripped = path.replace(/^\/it/, '') || '/';
  enHref = withBase(stripped);
  itHref = withBase(stripped === '/' ? '/it/' : `/it${stripped}`);
}
---

<div class="flex items-center text-xs uppercase tracking-wider">
  <a
    href={itHref}
    class:list={['inline-flex items-center py-2.5 px-1.5 hover:text-accent transition-colors', lang === 'it' ? 'text-accent font-semibold' : 'text-ink-muted']}
    aria-label="Italiano"
  >
    IT
  </a>
  <span class="text-ink-muted/50" aria-hidden="true">/</span>
  <a
    href={enHref}
    class:list={['inline-flex items-center py-2.5 px-1.5 hover:text-accent transition-colors', lang === 'en' ? 'text-accent font-semibold' : 'text-ink-muted']}
    aria-label="English"
  >
    EN
  </a>
</div>
